# ============================================================
# IronCore — Environment Variables Example
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#   # then edit .env with your actual API keys
# ============================================================

# ── Edition Control ──────────────────────────────────────────
# community   → Free, open source. Bypass modules disabled.
# enterprise  → Full features including all bypass modules.
#               Contact: enterprise@ironcore.dev for license.
IRONCORE_EDITION=community

# ── LLM Provider API Keys ────────────────────────────────────
# At least ONE provider key is required.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxx
OPENAI_API_KEY=sk-xxxxxx
GOOGLE_API_KEY=AIzaSyxxxxxx

# ── LiteLLM Tiered Model Routing ─────────────────────────────
# Map each complexity tier to the model you want to use.
# Prefix with  ollama/  for local models,  claude-/  or  gpt-  for cloud.
IRONCORE_LLM_SIMPLE_MODEL=ollama/llama3.1:8b
IRONCORE_LLM_MEDIUM_MODEL=claude-haiku-3-5
IRONCORE_LLM_COMPLEX_MODEL=claude-sonnet-4-6
IRONCORE_LLM_CRITICAL_MODEL=claude-opus-4-6

# ── VLM CAPTCHA Bridge ────────────────────────────────────────
# IRONCORE_VLM_BACKEND: "ollama" | "openai" | "disabled"
#
#   ollama  → Run:  docker compose --profile vlm up
#             (pulls and starts the local ollama container)
#
#   openai  → Uses OPENAI_API_KEY above. Model should be "gpt-4o"
#
#   disabled → CAPTCHA pipeline runs without VLM (lower success rate)
IRONCORE_VLM_BACKEND=ollama
IRONCORE_VLM_ENDPOINT=http://ollama:11434/api/generate
IRONCORE_VLM_MODEL=llava:13b
IRONCORE_VLM_TIMEOUT=30

# ── Security & Auth ──────────────────────────────────────────
# IRONCORE_VAULT_KEY: 32-byte (minimum) random key for AES-256 secrets vault.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
IRONCORE_VAULT_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_32

# API keys checked by the FastAPI server (Bearer token or X-API-Key header).
IRONCORE_API_KEY=ironcore-user-key
IRONCORE_ADMIN_API_KEY=ironcore-admin-key

# ── Infrastructure ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Worker Config ─────────────────────────────────────────────
# IRONCORE_WORKER_PROMPT: optional prompt to inject into background worker.
IRONCORE_WORKER_HEARTBEAT_SECONDS=30
IRONCORE_WORKER_MAX_ITERATIONS=10
IRONCORE_WORKER_PROMPT=

# ── Ollama GPU parallelism (optional) ────────────────────────
# Number of requests Ollama processes simultaneously.  Set 1 on CPU hosts.
OLLAMA_NUM_PARALLEL=2

# ── Observability ─────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR
IRONCORE_LOG_LEVEL=INFO
