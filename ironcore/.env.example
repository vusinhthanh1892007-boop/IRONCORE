# IronCore V2 — Environment Variables Template
# Sao chép file này thành .env và điền các giá trị thật
# KHÔNG bao giờ commit file .env vào git

# ─── Core Security ────────────────────────────────────────────
IRONCORE_VAULT_KEY=                     # Fernet key — generate bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ─── LLM API Keys ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-               # Claude (Haiku / Sonnet / Opus)
OPENAI_API_KEY=sk-                      # GPT-4o-mini / GPT-4.5
COHERE_API_KEY=co-                      # Phase 4: Cohere Rerank

# ─── LLM Bridge ───────────────────────────────────────────────
IRONCORE_MAX_BUDGET_USD=5.0             # Giới hạn cost mỗi session (USD)
IRONCORE_SESSION_ID=                    # Để trống = auto-generate UUID

# ─── V2 Optimizer: Phase 1 — Semantic Cache ──────────────────
IRONCORE_CACHE_ENABLED=true
IRONCORE_CACHE_SIMILARITY_THRESHOLD=0.92
IRONCORE_CACHE_DEFAULT_TTL=3600         # Giây (3600 = 1 giờ)
IRONCORE_CACHE_MAX_ENTRIES=10000        # Tối đa entries mỗi namespace
IRONCORE_CACHE_EMBEDDING_MODEL=all-MiniLM-L6-v2
IRONCORE_CACHE_PERSIST_DIR=~/.ironcore/cache

# ─── V2 Optimizer: Phase 2 — Anthropic KV-Cache ──────────────
IRONCORE_KV_CACHE_ENABLED=true
IRONCORE_KV_CACHE_MIN_TOKENS=1024
IRONCORE_KV_CACHE_SYSTEM_PROMPT=true
IRONCORE_KV_CACHE_TOOLS=true

# ─── V2 Optimizer: Phase 3 — Token Compression ───────────────
IRONCORE_COMPRESSION_ENABLED=true
IRONCORE_COMPRESSION_TOON=true
IRONCORE_COMPRESSION_LLMLINGUA=true
IRONCORE_COMPRESSION_MIN_TOKENS=2000
IRONCORE_COMPRESSION_KEEP_RATIO=0.70

# ─── V2 Optimizer: Phase 4 — Rerank ─────────────────────────
IRONCORE_RERANK_ENABLED=true
IRONCORE_RERANK_MODEL=rerank-english-v3.0
IRONCORE_RERANK_TOP_N=5

# ─── V2 Optimizer: Phase 5 — MCP Server ─────────────────────
IRONCORE_MCP_ENABLED=true
IRONCORE_MCP_ENDPOINT=/mcp

# ─── V2 Optimizer: Phase 6 — Sliding Window ────────────────
IRONCORE_SLIDING_WINDOW_ENABLED=true
IRONCORE_SLIDING_WINDOW_TRIGGER=0.75
IRONCORE_SUMM_MODEL=ollama/llama3.1:8b

# ─── Database ─────────────────────────────────────────────────
IRONCORE_DB_PATH=~/.ironcore/sessions.db

# ─── Sandbox ──────────────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock

# ─── V2 Architect: Phase 2 — OTA Updates ────────────────────
IRONCORE_OTA_ENABLED=true
IRONCORE_OTA_BACKUP_DIR=ironcore/data/ota_backups   # Nơi lưu rollback refs
IRONCORE_OTA_HEALTH_URL=http://localhost:8000/health # Health check URL sau core update
IRONCORE_OTA_HEALTH_TIMEOUT=30                       # Giây chờ health check

# ─── API Server (GPT-5.4 sẽ điền phần này) ──────────────────
IRONCORE_API_HOST=0.0.0.0
IRONCORE_API_PORT=8080
IRONCORE_API_SECRET=                    # JWT secret cho API auth
