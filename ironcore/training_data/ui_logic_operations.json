        {"id": "renameSession", "params": ["id", "name"], "effect": "updates session name + updatedAt"},
        {"id": "deleteSession", "params": ["id"], "effect": "removes session + messages; if active, switch to first"},
        {"id": "togglePinSession", "params": ["id"], "effect": "toggles session.pinned + updatedAt"},
        {"id": "addMessage", "params": ["sessionId", "message"], "effect": "appends to messagesBySession + updates session.updatedAt"},
        {"id": "appendToken", "params": ["sessionId", "messageId", "token"], "effect": "concatenates token to message.content (streaming)"},
        {"id": "finalizeMessage", "params": ["sessionId", "messageId", "meta"], "effect": "merges meta + sets isStreaming=false"},
        {"id": "setToolBadge", "params": ["sessionId", "messageId", "label", "status"], "effect": "upserts tool badge (running/done)"},
        {"id": "setStreaming", "params": ["value"], "effect": "sets global isStreaming flag"},
        {"id": "setModel", "params": ["model"], "effect": "sets currentModel"},
        {"id": "getActiveMessages", "params": [], "effect": "returns messages for activeSessionId"}
